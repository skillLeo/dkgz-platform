###############################################################################
# DKGZ — Deutsche KFZ-Gutachterzentrale
#
# Copy to .env on the server and fill in. Never commit the filled-in file.
# Anything the client changes day to day lives in the admin panel instead, so
# this file should need editing only at install time.
###############################################################################

APP_NAME="DKGZ Deutsche KFZ-Gutachterzentrale"
APP_ENV=production
APP_KEY=
# php artisan key:generate  — do this once, on the server, before first boot.

# MUST be false in production. With it on, a stack trace would expose the
# database credentials and the application key on any error page.
APP_DEBUG=false

APP_URL=https://dkgz.skillleo.com

# The interface is German throughout; these pin validation messages and dates.
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

###############################################################################
# Database
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

###############################################################################
# Shared hosting: everything on the database, nothing that needs a daemon.
#
# There is no Redis, no supervisor and no websocket server on this plan, so the
# queue is drained by the scheduler once a minute (see DEPLOYMENT.md for the
# cron line) and the portal polls for notifications instead of subscribing.
###############################################################################
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true once HTTPS is confirmed working on the live domain.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

###############################################################################
# Mail
#
# These are only the fallback. Once the client enters SMTP details under
# Administration → Integrationen, those override everything here at runtime
# and are stored encrypted. Leave this pointing somewhere harmless.
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@dkgz.de"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# First administrator
#
# Read once by ProductionSeeder. If DKGZ_ADMIN_PASSWORD is left empty a
# one-time password is generated and printed to the console — write it down,
# then remove both lines from this file.
###############################################################################
DKGZ_ADMIN_EMAIL=admin@dkgz.de
DKGZ_ADMIN_PASSWORD=

###############################################################################
# Logging
#
# `daily` keeps 14 files and rotates, which matters on a plan with a disk quota.
###############################################################################
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

###############################################################################
# Build
###############################################################################
VITE_APP_NAME="${APP_NAME}"
